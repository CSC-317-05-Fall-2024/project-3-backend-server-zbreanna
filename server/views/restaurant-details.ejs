<!DOCTYPE html>
<html lang="en">

<head>
    <title>Travel Guide</title>
    <!-- Corrected CSS reference -->
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/restaurant-details-styles.css"> 
</head>

<body>
    <header></header>
    <nav></nav>
    
